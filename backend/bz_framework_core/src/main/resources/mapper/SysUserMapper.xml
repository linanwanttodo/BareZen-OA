<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linan.system.mapper.SysUserMapper">

    <!-- 通用字段映射 -->
    <resultMap id="BaseResultMap" type="com.linan.system.entity.SysUser">
        <id column="id" property="id" />
        <result column="user_name" property="userName" />
        <result column="nick_name" property="nickName" />
        <result column="email" property="email" />
        <result column="phone" property="phone" />
        <result column="sex" property="sex" />
        <result column="avatar" property="avatar" />
        <result column="status" property="status" />
        <result column="login_ip" property="loginIp" />
        <result column="login_date" property="loginDate" />
        <result column="remark" property="remark" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
        <result column="del_flag" property="delFlag" />
    </resultMap>

    <!-- 按角色ID和/或部门ID筛选用户（分页） -->
    <select id="selectUsersByRoleDept" resultMap="BaseResultMap">
        SELECT DISTINCT u.*
        FROM sys_user u
        <if test="roleIds != null and roleIds.size() > 0">
            LEFT JOIN sys_user_role ur ON u.id = ur.user_id
        </if>
        <if test="deptIds != null and deptIds.size() > 0">
            LEFT JOIN sys_user_dept ud ON u.id = ud.user_id
        </if>
        <where>
            u.del_flag = 0
            <if test="roleIds != null and roleIds.size() > 0">
                AND ur.role_id IN
                <foreach collection="roleIds" item="rid" open="(" separator="," close=")">
                    #{rid}
                </foreach>
            </if>
            <if test="deptIds != null and deptIds.size() > 0">
                AND ud.dept_id IN
                <foreach collection="deptIds" item="did" open="(" separator="," close=")">
                    #{did}
                </foreach>
            </if>
            <if test="userName != null and userName != ''">
                AND u.user_name LIKE CONCAT('%', #{userName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND u.status = #{status}
            </if>
        </where>
        ORDER BY u.create_time DESC
    </select>

    <!-- 按角色ID和/或部门ID统计用户总数 -->
    <select id="countUsersByRoleDept" resultType="java.lang.Long">
        SELECT COUNT(DISTINCT u.id)
        FROM sys_user u
        <if test="roleIds != null and roleIds.size() > 0">
            LEFT JOIN sys_user_role ur ON u.id = ur.user_id
        </if>
        <if test="deptIds != null and deptIds.size() > 0">
            LEFT JOIN sys_user_dept ud ON u.id = ud.user_id
        </if>
        <where>
            u.del_flag = 0
            <if test="roleIds != null and roleIds.size() > 0">
                AND ur.role_id IN
                <foreach collection="roleIds" item="rid" open="(" separator="," close=")">
                    #{rid}
                </foreach>
            </if>
            <if test="deptIds != null and deptIds.size() > 0">
                AND ud.dept_id IN
                <foreach collection="deptIds" item="did" open="(" separator="," close=")">
                    #{did}
                </foreach>
            </if>
            <if test="userName != null and userName != ''">
                AND u.user_name LIKE CONCAT('%', #{userName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND u.status = #{status}
            </if>
        </where>
    </select>

    <!-- 按角色ID和/或部门ID筛选用户（MyBatis-Plus 分页版） -->
    <select id="selectUsersByRoleDeptPage" resultMap="BaseResultMap">
        SELECT DISTINCT u.*
        FROM sys_user u
        <if test="roleIds != null and roleIds.size() > 0">
            LEFT JOIN sys_user_role ur ON u.id = ur.user_id
        </if>
        <if test="deptIds != null and deptIds.size() > 0">
            LEFT JOIN sys_user_dept ud ON u.id = ud.user_id
        </if>
        <where>
            u.del_flag = 0
            <if test="roleIds != null and roleIds.size() > 0">
                AND ur.role_id IN
                <foreach collection="roleIds" item="rid" open="(" separator="," close=")">
                    #{rid}
                </foreach>
            </if>
            <if test="deptIds != null and deptIds.size() > 0">
                AND ud.dept_id IN
                <foreach collection="deptIds" item="did" open="(" separator="," close=")">
                    #{did}
                </foreach>
            </if>
            <if test="userName != null and userName != ''">
                AND u.user_name LIKE CONCAT('%', #{userName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND u.status = #{status}
            </if>
        </where>
        ORDER BY u.create_time DESC
    </select>

    <!-- 批量查询用户的角色名称（逗号分隔） -->
    <select id="selectUserRoleNames" resultType="com.linan.system.entity.UserRoleDeptVo">
        SELECT u.id AS userId,
               GROUP_CONCAT(DISTINCT r.role_name ORDER BY r.role_sort SEPARATOR ', ') AS roleNames
        FROM sys_user u
        LEFT JOIN sys_user_role ur ON u.id = ur.user_id
        LEFT JOIN sys_role r ON ur.role_id = r.id
        WHERE u.del_flag = 0 AND r.del_flag = 0
        GROUP BY u.id
    </select>

    <!-- 批量查询用户的部门名称（逗号分隔） -->
    <select id="selectUserDeptNames" resultType="com.linan.system.entity.UserRoleDeptVo">
        SELECT u.id AS userId,
               GROUP_CONCAT(DISTINCT d.dept_name ORDER BY d.sort SEPARATOR ', ') AS deptNames
        FROM sys_user u
        LEFT JOIN sys_user_dept ud ON u.id = ud.user_id
        LEFT JOIN sys_dept d ON ud.dept_id = d.id
        WHERE u.del_flag = 0 AND d.del_flag = 0
        GROUP BY u.id
    </select>

</mapper>
