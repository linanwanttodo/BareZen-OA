<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.linan.article.mapper.ArtArticleMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.linan.article.entity.ArtArticle">
        <id column="id" property="id" />
        <result column="author_id" property="authorId" />
        <result column="author_name" property="authorName" />
        <result column="category_id" property="categoryId" />
        <result column="category_name" property="categoryName" />
        <result column="title" property="title" />
        <result column="summary" property="summary" />
        <result column="content" property="content" />
        <result column="cover_image" property="coverImage" />
        <result column="view_count" property="viewCount" />
        <result column="like_count" property="likeCount" />
        <result column="comment_count" property="commentCount" />
        <result column="status" property="status" />
        <result column="tags" property="tags" />
        <result column="order_num" property="orderNum" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 查询用户收藏的文章（JOIN 优化，替代 N+1） -->
    <select id="selectFavoritedArticlesByUserId" resultMap="BaseResultMap">
        SELECT a.*
        FROM art_favorite f
        JOIN art_article a ON f.article_id = a.id
        WHERE f.user_id = #{userId}
        ORDER BY f.create_time DESC
    </select>

</mapper>
