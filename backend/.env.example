# docker compose / 生产环境变量模板
# 复制为 .env 后按环境填写；密钥类变量无默认值，缺失时 compose 会直接报错（fail-fast）。
# 生成强随机 JWT 密钥示例：openssl rand -base64 48

# MySQL（必填，勿使用 123456 等弱口令）
DB_PASSWORD=

# 可选
DB_NAME=barezen_oa
DB_USER=root

# Redis（可选，无密码留空）
REDIS_PASSWORD=

# JWT（必填，至少 32 字符强随机）
JWT_SECRET=

# 业务配置
AUTH_REGISTER_ENABLED=false
# 生产 CORS 白名单，逗号分隔，如 https://admin.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=