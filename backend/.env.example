# ============================================
# BareZen_Base 环境变量示例（复制为 .env 或注入容器）
# ============================================
# 使用方式：
#   本地开发：复制为 .env 文件，Spring Boot 自动读取
#   Docker：docker-compose.yml 中已配置环境变量映射，只需设置 DB_PASSWORD 等敏感值
#

# ---- 数据库（MySQL 8.0+）----
# 注意：在 Docker Compose 中，DB_HOST 会被覆写为服务名 "mysql"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=barezen_base
DB_USER=root
DB_PASSWORD=123456

# ---- Redis 7.0+ ----
# 注意：在 Docker Compose 中，REDIS_HOST 会被覆写为服务名 "redis"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT（生产务必设置随机密钥：openssl rand -base64 32）----
# 注意：下方为仅用于本地开发的开箱即用密钥，请勿用于生产环境。
# 生产部署前必须通过如下命令生成并替换为高强度随机密钥：
#   openssl rand -base64 32
# 说明：JwtUtil 启动时会校验密钥长度（>=32字符）并拒绝已知公开弱密钥；
#       历史示例值 bXktZGV2LWp3dC1zZWNyZXQta2V5LWZvci1sb2NhbC1kZXZlbG9wbWVudA==
#       已被列入弱密钥黑名单，使用会导致应用启动失败，故已替换。
JWT_SECRET=dev-only-DO-NOT-USE-IN-PROD-replace-with-openssl-rand-base64-32
JWT_EXPIRATION=86400000

# ---- 注册开关（生产建议关闭）----
AUTH_REGISTER_ENABLED=false

# ---- CORS 允许来源（逗号分隔；空=开发模式放行所有）----
CORS_ALLOWED_ORIGINS=

# ---- 应用端口 ----
SERVER_PORT=8080

# ---- 文件上传路径（容器内路径，由 docker-compose volume 持久化）----
BAREZEN_UPLOAD_PATH=./uploads
